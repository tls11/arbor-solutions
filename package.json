{
  "name": "arbor-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./public/output.css --minify",
    "tailwind": "tailwindcss -i ./src/input.css -o ./public/output.css --watch --minify",
    "dev": "concurrently -k -n css,web \"pnpm run tailwind\" \"serve public --no-clipboard --listen 3000\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17"
  },
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d"
}
